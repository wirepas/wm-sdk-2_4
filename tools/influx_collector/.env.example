# Copy to .env and fill in.  docker compose reads this automatically.

# ── Wirepas MQTT backend ──────────────────────────────────────────────────────
WIREPAS_MQTT_HOST=wnt.dev.bienesis.fr
WIREPAS_MQTT_PORT=8883
WIREPAS_MQTT_USER=mqttmasteruser
WIREPAS_MQTT_PASSWORD=changeme
# 1 = TLS without certificate verification (self-signed brokers)
WIREPAS_MQTT_INSECURE=0

# ── InfluxDB ──────────────────────────────────────────────────────────────────
# For the bundled InfluxDB 2.x service these also drive its first-boot setup.
INFLUX_ORG=wirepas
INFLUX_BUCKET=sensors
# Pick a long random string — it becomes the admin token AND the collector token.
INFLUX_TOKEN=please-generate-a-long-random-token
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-this-admin-password

# Collector → InfluxDB connection (service name on the compose network).
INFLUX_URL=http://influxdb:8086
# InfluxDB 2.x → Token   |   InfluxDB 3 Core → Bearer
INFLUX_AUTH_SCHEME=Token

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

LOG_LEVEL=INFO
